@echo off
chcp 65001 >nul
echo ========================================================
echo   正在將 LINE 記帳機器人程式碼推播至 GitHub...
echo ========================================================
cd /d "%~dp0"
"C:\Program Files\Git\cmd\git.exe" push -u origin main
echo.
if %errorlevel% equ 0 (
    echo ========================================================
    echo   [成功] 程式碼已成功推播至 GitHub！
    echo   請前往 Render.com 進行下一步 Web Service 部署。
    echo ========================================================
) else (
    echo ========================================================
    echo   [失敗] 推播失敗，請檢查 GitHub 登入驗證。
    echo ========================================================
)
pause
