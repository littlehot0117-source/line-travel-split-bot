# LINE Messaging API 憑證
# 請在 LINE Developers Console (https://developers.line.biz/) 的 Channel 頁面取得
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# 資料庫連線字串
# 本機開發：若未設定或留空，將自動使用 SQLite (sqlite:///./travel_split.db)
# 雲端資料庫 (Supabase / PostgreSQL) 範例：
# postgresql://postgres:your_password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./travel_split.db

# 伺服器設定
PORT=8000
HOST=0.0.0.0
